{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kace.local/schema/board-contract-v1.json",
  "title": "KACE BoardContract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "board_id", "display_name", "manufacturer", "family_id",
    "revision", "aliases", "upstream", "hardware_variants", "warnings",
    "contract_digest"
  ],
  "properties": {
    "schema": {"const": "kace-board-contract/v1"},
    "board_id": {"$ref": "#/$defs/id"},
    "display_name": {"$ref": "#/$defs/nonEmptyString"},
    "manufacturer": {"$ref": "#/$defs/nonEmptyString"},
    "family_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/nonEmptyString"},
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_config_filenames", "legacy_exact"],
      "properties": {
        "official_config_filenames": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+\\.cfg$"}
        },
        "legacy_exact": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        }
      }
    },
    "upstream": {"$ref": "#/$defs/upstream"},
    "hardware_variants": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/hardwareVariant"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    },
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "reference"],
        "properties": {
          "source": {"$ref": "#/$defs/id"},
          "reference": {"$ref": "#/$defs/nonEmptyString"},
          "detail": {"type": "string"}
        }
      }
    },
    "kconfigMap": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^CONFIG_[A-Za-z0-9_]+$"},
      "additionalProperties": {"type": ["boolean", "integer", "string"]}
    },
    "upstream": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_contract", "repository", "validated_commit", "config_path",
        "config_sha256_lf", "header_sha256_lf", "header_text"
      ],
      "properties": {
        "source_contract": {"const": "kace-klipper-source/v1"},
        "repository": {"const": "https://github.com/Klipper3d/klipper.git"},
        "validated_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "config_path": {"type": "string", "pattern": "^config/[A-Za-z0-9.-]+\\.cfg$"},
        "config_sha256_lf": {"$ref": "#/$defs/sha256"},
        "header_sha256_lf": {"$ref": "#/$defs/sha256"},
        "header_text": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "processor": {
      "type": "object", "additionalProperties": false,
      "required": [
        "architecture", "architecture_kconfig", "model", "model_kconfig",
        "resolved_mcu", "provenance"
      ],
      "properties": {
        "architecture": {"enum": ["stm32", "lpc176x", "rpxxxx", "avr", "atsam", "atsamd", "linux"]},
        "architecture_kconfig": {"type": "string", "pattern": "^CONFIG_MACH_[A-Za-z0-9_]+$"},
        "model": {"$ref": "#/$defs/nonEmptyString"},
        "model_kconfig": {"type": "string", "pattern": "^CONFIG_MACH_[A-Za-z0-9_]+$"},
        "resolved_mcu": {"$ref": "#/$defs/nonEmptyString"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "bootloader": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "selection", "application_address", "provenance"],
      "properties": {
        "label": {"$ref": "#/$defs/nonEmptyString"},
        "selection": {"type": "object", "propertyNames": {"pattern": "^CONFIG_"}},
        "application_address": {"type": ["string", "null"], "pattern": "^0x[0-9A-Fa-f]+$"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "clock": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "selection", "reference_hz", "provenance"],
      "properties": {
        "label": {"$ref": "#/$defs/nonEmptyString"},
        "selection": {"type": "object", "propertyNames": {"pattern": "^CONFIG_"}},
        "reference_hz": {"type": "integer", "minimum": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "selection", "endpoint", "host_connection", "provenance"],
      "properties": {
        "kind": {"enum": ["USB", "UART", "CAN"]},
        "selection": {"$ref": "#/$defs/kconfigMap"},
        "endpoint": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/nonEmptyString"}},
        "host_connection": {"$ref": "#/$defs/id"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "lowLevel": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "startup_gpio", "provenance"],
      "properties": {
        "enabled": {"type": "boolean"},
        "startup_gpio": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["native_path", "native_filename", "format", "final_filename", "provenance"],
      "properties": {
        "native_path": {"$ref": "#/$defs/nonEmptyString"},
        "native_filename": {"$ref": "#/$defs/nonEmptyString"},
        "format": {"enum": ["BIN", "UF2", "IHEX"]},
        "final_filename": {
          "type": "object", "additionalProperties": false, "required": ["strategy"],
          "properties": {
            "strategy": {"enum": ["fixed", "native", "build-id"]},
            "value": {"type": "string"},
            "template": {"type": "string"},
            "required_suffix": {"type": "string"},
            "must_differ_from_last_successful_flash": {"type": "boolean"}
          }
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "flash": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "steps", "command", "options", "provenance"],
      "properties": {
        "strategy": {"enum": ["PREPARE_ONLY", "SD_CARD", "AVRDUDE", "DFU_UTIL", "MAKE_FLASH", "RAW_ADDRESS", "RP2040_BOOTSEL"]},
        "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "command": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["backend", "argv"],
              "properties": {
                "backend": {"enum": ["avrdude", "dfu-util", "make-flash", "raw-flash"]},
                "argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
              }
            }
          ]
        },
        "options": {"type": "object"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "buildTarget": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "support_status", "transport", "low_level", "requested_kconfig",
        "resolved_assertions", "kconfig_provenance", "artifact", "flash"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "support_status": {"enum": ["PROVISIONAL", "BUILD_VERIFIED", "DEPLOYMENT_VERIFIED", "RUNTIME_SUPPORTED", "CONFIG_ONLY", "BLOCKED"]},
        "transport": {"$ref": "#/$defs/transport"},
        "low_level": {"$ref": "#/$defs/lowLevel"},
        "requested_kconfig": {"$ref": "#/$defs/kconfigMap"},
        "resolved_assertions": {"$ref": "#/$defs/kconfigMap"},
        "kconfig_provenance": {"$ref": "#/$defs/provenance"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "flash": {"$ref": "#/$defs/flash"}
      }
    },
    "hardwareVariant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "processor", "bootloader", "clock", "build_targets"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "processor": {"$ref": "#/$defs/processor"},
        "bootloader": {"$ref": "#/$defs/bootloader"},
        "clock": {"$ref": "#/$defs/clock"},
        "build_targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/buildTarget"}}
      }
    },
    "warning": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "severity", "text", "incompatible_board_ids", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "severity": {"enum": ["INFO", "WARNING", "CRITICAL", "BLOCKING"]},
        "text": {"$ref": "#/$defs/nonEmptyString"},
        "incompatible_board_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
